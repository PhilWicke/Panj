    "title_sl": "Dan v mestu",
    "title_en": "A day in town",
    "setting_en": "A day trip into town. You ask a passer-by, an older person, the way to the old town. Later, at the station, you buy a ticket home from a clerk.",
    "lines": [
      {
        "speaker": "you",
        "sl": "Oprostite, mi lahko pomagate? Kje je staro mesto?",
        "en": "Excuse me, can you help me? Where is the old town?",
        "new_items": [
          "u07-l05-i01",
          "u07-l05-i04"
        ]
      },
      {
        "speaker": "passer-by",
        "sl": "Pojdite naravnost, pri cerkvi levo.",
        "en": "Go straight on, left at the church."
      },
      {
        "speaker": "you",
        "sl": "Je to prava smer? Kako dolgo traja?",
        "en": "Is this the right way? How long does it take?",
        "new_items": [
          "u07-l05-i02",
          "u07-l05-i03"
        ]
      },
      {
        "speaker": "passer-by",
        "sl": "Ja. Peš je deset minut.",
        "en": "Yes. It's ten minutes on foot."
      },
      {
        "speaker": "you",
        "sl": "Hvala za pomoč.",
        "en": "Thanks for the help.",
        "new_items": [
          "u07-l05-i06"
        ]
      },
      {
        "speaker": "clerk",
        "sl": "Dober dan. Kaj želite?",
        "en": "Good day. What would you like?"
      },
      {
        "speaker": "you",
        "sl": "Eno karto za Ljubljano, prosim. Enosmerno.",
        "en": "One ticket to Ljubljana, please. One way.",
        "new_items": [
          "u07-l04-i01"
        ]
      },
      {
        "speaker": "clerk",
        "sl": "Izvolite. Vlak gre ob šestih, na peronu 1.",
        "en": "Here you are. The train leaves at six, on platform 1."
      }
    ]
  }
