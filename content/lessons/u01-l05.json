        ]
      },
      {
        "speaker": "host",
        "sl": "Kako ste? Od kod ste?",
        "en": "How are you? Where are you from?"
      },
      {
        "speaker": "you",
        "sl": "Dobro, hvala. Sem iz Avstrije.",
        "en": "Fine, thank you. I'm from Austria.",
        "new_items": [
          "u01-l02-i05",
          "u01-l03-i03"
        ]
      },
      {
        "speaker": "host",
        "sl": "Niste od tukaj? Ste na obisku?",
        "en": "You're not from here? Are you visiting?"
      },
      {
        "speaker": "you",
        "sl": "Ja, sem na obisku.",
        "en": "Yes, I'm visiting.",
