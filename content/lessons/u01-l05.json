    "lines": [
      {
        "speaker": "host",
        "sl": "Dober dan. Dobrodošli. Kar naprej.",
        "en": "Good day. Welcome. Come on in."
      },
      {
        "speaker": "you",
        "sl": "Dober dan. Hvala lepa.",
