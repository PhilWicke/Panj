        ]
      },
      {
        "speaker": "clerk",
        "sl": "Žal ne, nimamo več.",
        "en": "I'm afraid not, we don't have any more."
      },
      {
        "speaker": "you",
        "sl": "Ni več kruha? Kaj pa to?",
        "en": "No more bread? What about this?",
        "new_items": [
          "u04-l04-i02"
        ]
      },
      {
        "speaker": "clerk",
        "sl": "To je pecivo. Zelo je dobro.",
        "en": "That's pastry. It's very good."
      },
      {
        "speaker": "you",
        "sl": "Dobro, vzamem to. Kje je blagajna?",
        "en": "All right, I'll take this. Where is the checkout?",
        "new_items": [
          "u04-l04-i05",
          "u04-l04-i06"
        ]
      },
      {
        "speaker": "clerk",
        "sl": "Blagajna je tam. Hvala in nasvidenje.",
