  "dialogue": {
    "id": "u08-l05-d",
    "title_sl": "V nedeljo",
    "title_en": "On Sunday",
    "setting_en": "Your hosts invite you on a Sunday walk in the hills. You talk about the weather and about last weekend.",
    "cast": {
      "host": "female"
    },
    "lines": [
      {
        "speaker": "host",
        "sl": "V nedeljo gremo v hribe. Greš z nami?",
        "en": "On Sunday we're going to the hills. Are you coming with us?"
      },
      {
        "speaker": "you",
        "sl": "Z veseljem. Rad hodim v hribe.",
        "en": "With pleasure. I like hiking in the hills. (a man speaking)",
        "new_items": [
          "u08-l05-i03",
          "u08-l01-i04"
        ]
      },
      {
        "speaker": "host",
        "sl": "Fajn. V nedeljo bo lepo vreme.",
        "en": "Nice. On Sunday the weather will be nice."
      },
      {
        "speaker": "you",
        "sl": "Danes dežuje in mrzlo je.",
        "en": "It's raining today and it's cold.",
        "new_items": [
          "u08-l03-i03",
          "u08-l03-i05"
        ]
      },
      {
        "speaker": "host",
        "sl": "Kje si bil prejšnji vikend?",
        "en": "Where were you last weekend?"
      },
      {
        "speaker": "you",
        "sl": "Bil sem na morju. Bilo je lepo.",
        "en": "I was at the seaside. It was lovely. (a man speaking)",
        "new_items": [
          "u08-l04-i02",
          "u08-l04-i05"
        ]
      },
      {
        "speaker": "host",
        "sl": "Se vidimo v nedeljo. Imej se lepo.",
        "en": "See you on Sunday. Have a good time."
      },
      {
        "speaker": "you",
        "sl": "Hvala, imej se lepo.",
        "en": "Thank you, have a good time.",
        "new_items": [
          "u08-l05-i05"
        ]
      }
    ]
