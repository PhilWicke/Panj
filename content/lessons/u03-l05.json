          "u03-l03-i03",
          "u03-l05-i03",
          "u03-l05-i05"
        ]
      },
      {
        "speaker": "host",
        "sl": "Ja, lahko. Pa kavo?",
        "en": "Yes, you can. What about a coffee?"
      },
      {
        "speaker": "you",
        "sl": "Ne, hvala. Hvala za kosilo.",
