    "lines": [
      {
        "speaker": "host",
        "sl": "Kosilo je na mizi. Sedite, prosim.",
        "en": "Lunch is on the table. Please sit down."
      },
      {
        "speaker": "you",
        "sl": "Hvala. Lahko pomagam?",
