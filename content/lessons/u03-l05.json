        "sl": "Ni treba. Dober tek.",
        "en": "There's no need. Enjoy your meal."
      },
      {
        "speaker": "you",
        "sl": "Hvala, dober tek. Kje je sol?",
        "en": "Thank you, enjoy your meal. Where is the salt?",
        "new_items": [
          "u03-l02-i01",
          "u03-l05-i04"
        ]
      },
      {
        "speaker": "host",
        "sl": "Tukaj je. Še malo krompirja?",
        "en": "Here it is. A few more potatoes?"
      },
      {
        "speaker": "you",
        "sl": "Ja, prosim. Res je okusno. Lahko dobim recept?",
        "en": "Yes, please. It's really tasty. Can I have the recipe?",
