    "title_sl": "Družinske slike",
    "title_en": "Family photos",
    "setting_en": "After dinner, your hosts show you photos of their family on the phone.",
    "lines": [
      {
        "speaker": "host",
        "sl": "To je moja družina.",
        "en": "This is my family."
      },
      {
        "speaker": "you",
        "sl": "Kdo je to?",
        "en": "Who is this?",
        "new_items": [
          "u02-l02-i01"
        ]
      },
      {
        "speaker": "host",
        "sl": "To je moj oče. In to je moja mama.",
        "en": "This is my father. And this is my mum."
      },
      {
        "speaker": "you",
        "sl": "In to? Sin in hčerka?",
        "en": "And this? Your son and daughter?",
        "new_items": [
          "u02-l02-i07",
          "u02-l02-i08"
        ]
      },
      {
        "speaker": "host",
        "sl": "Ja, to sta moj sin in moja hčerka.",
        "en": "Yes, these are my son and my daughter."
      }
    ]
