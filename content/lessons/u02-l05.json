  "dialogue": {
    "id": "u02-l05-d",
    "title_sl": "V nedeljo popoldne",
    "title_en": "On a Sunday afternoon",
    "setting_en": "On a Sunday afternoon you visit relatives of your hosts on your own. One of them, who says ti to you, opens the door and later sees you off.",
    "cast": {
      "host": "male"
    },
    "lines": [
      {
        "speaker": "you",
        "sl": "Živjo. Lepo te je videti.",
        "en": "Hi. It's good to see you.",
        "new_items": [
          "u02-l05-i01"
        ]
      },
      {
        "speaker": "host",
        "sl": "Živjo. Kar naprej. Kako so vsi doma?",
        "en": "Hi. Come on in. How is everyone at home?"
      },
      {
        "speaker": "you",
        "sl": "Vsi so zdravi, hvala. Kje so otroci?",
        "en": "Everyone is well, thank you. Where are the children?",
        "new_items": [
          "u02-l05-i03",
          "u02-l05-i04"
        ]
      },
      {
        "speaker": "host",
        "sl": "Tukaj sta. To sta sin in hčerka.",
        "en": "Here they are. These are our son and daughter."
      },
      {
        "speaker": "you",
        "sl": "Živjo. Koliko si star? Štiri?",
        "en": "Hi. How old are you? Four?",
        "new_items": [
          "u02-l03-i03",
          "u02-l04-i08"
        ]
      },
      {
        "speaker": "host",
        "sl": "Ja, štiri. In ti? Imaš otroke?",
        "en": "Yes, four. And you? Do you have children?"
      },
      {
        "speaker": "you",
        "sl": "Ne, nimam otrok. Imam dve sestri.",
        "en": "No, I don't have children. I have two sisters.",
        "new_items": [
          "u02-l01-i04",
          "u02-l04-i03"
        ]
      },
      {
        "speaker": "host",
        "sl": "Lepo. Pozdravi vse doma. Pridite spet.",
        "en": "Lovely. Say hello to everyone at home. Come again, all of you."
      }
    ]
