    "title_sl": "Za mizo v kavarni",
    "title_en": "At a café table",
    "setting_en": "You sit at a café table with one of your hosts, who says ti to you. You order, the drinks come, and you ask for the bill.",
    "lines": [
      {
        "speaker": "waiter",
        "sl": "Dober dan. Kaj boste?",
        "en": "Good day. What will you have?"
      },
      {
        "speaker": "host",
        "sl": "Eno kavo, prosim. Pa ti?",
        "en": "One coffee, please. And you?"
      },
      {
        "speaker": "you",
        "sl": "Zame čaj in kozarec vode, prosim.",
        "en": "Tea for me and a glass of water, please.",
        "new_items": [
