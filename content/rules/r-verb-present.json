{
  "id": "r-verb-present",
  "unit": "u05",
  "title_en": "Verbs in the present: delam, berem, spim",
  "card_en": "In the present, most verbs share endings: -m, -š and none in the singular, -va, -ta, -ta in the dual, -mo, -te, -jo in the plural. A vowel comes first: delam, berem, spim.",
  "example": {
    "sl": "Zjutraj delam, zvečer berem.",
    "en": "In the morning I work, in the evening I read."
  },
  "table": {
    "rows": [
      "1",
      "2",
      "3"
    ],
    "cols": [
      "sg",
      "du",
      "pl"
    ],
    "cells": {
      "1.sg": {
        "form": "delam, berem, spim",
        "pronoun": "jaz",
        "note_en": "brati, to read, changes its stem: berem."
      },
      "2.sg": {
        "form": "delaš, bereš, spiš",
        "pronoun": "ti"
      },
      "3.sg": {
        "form": "dela, bere, spi",
        "pronoun": "on/ona"
      },
      "1.du": {
        "form": "delava, bereva, spiva",
        "pronoun": "midva"
      },
      "2.du": {
        "form": "delata, bereta, spita",
        "pronoun": "vidva"
      },
      "3.du": {
        "form": "delata, bereta, spita",
        "pronoun": "onadva",
        "note_en": "Same form as for vidva."
      },
      "1.pl": {
        "form": "delamo, beremo, spimo",
        "pronoun": "mi"
      },
      "2.pl": {
        "form": "delate, berete, spite",
        "pronoun": "vi",
        "note_en": "Also the polite you: vi delate."
      },
      "3.pl": {
        "form": "delajo, berejo, spijo",
        "pronoun": "oni"
      }
    }
  },
  "toggles": [
    {
      "label": "Verb",
      "options": [
        "delati, to work",
        "brati, to read",
        "spati, to sleep"
      ],
      "examples": {
        "delati, to work": {
          "sl": "Kaj delaš?",
          "en": "What are you doing?"
        },
        "brati, to read": {
          "sl": "Kaj bereš?",
          "en": "What are you reading?"
        },
        "spati, to sleep": {
          "sl": "Še spiš?",
          "en": "Are you still asleep?"
        }
