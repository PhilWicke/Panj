  "quick_check": {
    "prompt_sl": "Oni ___ do petih.",
    "options": [
      "dela",
      "delajo",
      "delate"
    ],
    "answer": "delajo",
    "explain_en": "Oni, they, takes the ending -jo: delajo."
  },
  "helper_de": "The ending shows who, as in German, but the pronoun is usually left out: delam, ich arbeite.",
  "helper_en": "One present for both I work and I'm working: delam."
}
